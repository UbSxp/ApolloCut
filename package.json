{
  "name": "apollocut",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Ateliê local de cortes verticais com legendas e exportação no navegador.",
  "scripts": {
    "check": "node --check app.js && node --check lib/captions.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:export": "node tests/ui-export.test.js",
    "test:integration": "vitest run tests/integration.test.js",
    "test:all": "npm run check && npm run test && npm run test:integration",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev-server.js",
    "servir": "node tools/servir.mjs 4173",
    "vendor": "node scripts/vendor-transformers.mjs",
    "teste": "node tests/e2e/run-all.mjs",
    "fumaca": "node tests/e2e/abas-e-previa.mjs",
    "auditoria": "node tests/e2e/run-all.mjs && node tests/e2e/abas-e-previa.mjs && node tests/legendas/auditar.mjs && node tests/legendas/subcaminho.mjs",
    "auditoria-subcaminho": "node tests/legendas/subcaminho.mjs",
    "medir": "node tests/legendas/medir.mjs",
    "testes": "node --test tests/legendas/texto.test.mjs tests/legendas/segmentacao.test.mjs",
    "clipes": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/legendas/gerar-clipes.ps1",
    "fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gerar-fixtures.ps1",
    "pwa:generate": "workbox generateSW workbox-config.cjs",
    "ci": "npm run test:all && npm run build",
    "a11y": "node scripts/a11y-check.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@huggingface/transformers": "^3.7.5",
    "@vitest/ui": "^2.0.0",
    "esbuild": "^0.23.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "workbox-cli": "^7.1.0"
  }
}
